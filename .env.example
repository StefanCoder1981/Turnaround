# Kopie als .env anlegen und Schlüssel eintragen. Die .env wird nie committet.
# Alle Schlüssel mit Lese-Rechten anlegen – Ausnahme: der optionale eToro-Demo-Schlüssel unten.

# Bitpanda Fusion (app.bitpanda.com → Kontoeinstellungen → API-Schlüssel → Fusion, Scope "Read")
FUSION_API_KEY=

# Optional: klassische Bitpanda-API für das Hauptkonto inkl. Aktien/ETFs/Metalle
# (app.bitpanda.com → Kontoeinstellungen → API). Der Fusion-Schlüssel gilt dort nicht.
BITPANDA_API_KEY=

# eToro (Einstellungen → Trading → API Key Management, Berechtigung "Read")
ETORO_API_KEY=
ETORO_USER_KEY=

# Optional: eToro-User-Key für das DEMOkonto mit Berechtigung "Write" – nur damit kann die App das
# Demo-Depot ans Musterportfolio angleichen. Er wird nur für Orders benutzt (zusammen mit ETORO_API_KEY);
# Lesen/Marktdaten laufen weiter über ETORO_USER_KEY. Echtgeld-Konten werden nie gehandelt.
ETORO_API_WRITE=
