# Kopie als .env anlegen und Schlüssel eintragen. Die .env wird nie committet.
# Alle Schlüssel nur mit Lese-Rechten anlegen – die App führt keine Orders aus.

# Bitpanda Fusion (app.bitpanda.com → Kontoeinstellungen → API-Schlüssel → Fusion, Scope "Read")
FUSION_API_KEY=

# Optional: klassische Bitpanda-API für das Hauptkonto inkl. Aktien/ETFs/Metalle
# (app.bitpanda.com → Kontoeinstellungen → API). Der Fusion-Schlüssel gilt dort nicht.
BITPANDA_API_KEY=

# eToro (Einstellungen → Trading → API Key Management, Berechtigung "Read")
ETORO_API_KEY=
ETORO_USER_KEY=
